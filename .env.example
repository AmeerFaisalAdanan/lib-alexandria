# Copy to .env (never commit .env). Everything here is read by docker-compose.yml.

POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- production (default)
APP_ENV=production
AUTH_MODE=cloudflare
# Cloudflare Zero Trust > Access > Applications > your app. Team domain is <team>.cloudflareaccess.com.
CF_ACCESS_TEAM_DOMAIN=
# The application's "Application Audience (AUD) Tag".
CF_ACCESS_AUD=

CATALOGUE_SOURCE=sheets
# The id in the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
SHEETS_SPREADSHEET_ID=
# Tab and columns. Header row must contain: book_id, title, author, language, category
# (optional: isbn, publisher, publication_year).
SHEETS_RANGE=Catalogue!A:H
# Share the sheet (Viewer) with the service account's e-mail, then point at its JSON key on the host:
GOOGLE_CREDENTIALS_HOST_PATH=./.secrets/google-service-account.json
GOOGLE_CREDENTIALS_FILE=/run/secrets/google.json
CATALOGUE_TTL=5m

# ---------------------------------------------------------------- publishing and scanning
# Members may add books to the shared catalogue (the backend appends a row to the sheet, so the service
# account must be an EDITOR of the sheet, not a Viewer). Set to false for a read-only catalogue.
CATALOGUE_SUBMISSIONS=true
SUBMISSION_LIMIT_PER_DAY=20

# Barcode scan -> autofill from the ISBN. Open Library needs no key. Google Books works without one but its
# shared quota is often exhausted (HTTP 429), so a key makes it reliable (optional).
BOOK_LOOKUP=online
GOOGLE_BOOKS_API_KEY=

# Cover photo -> autofill, read by a Claude vision model. The photo is sent to Anthropic. Off unless a key is set.
COVER_SCAN=auto
ANTHROPIC_API_KEY=
# Defaults to Claude Opus 5.5; a cheaper model also reads covers (e.g. claude-sonnet-5-5 or claude-haiku-4-5).
COVER_SCAN_MODEL=claude-opus-5-5
LOOKUP_LIMIT_PER_DAY=300
COVER_LIMIT_PER_DAY=30

# ---------------------------------------------------------------- local / LAN development
# Uncomment these (and comment out the Cloudflare/Sheets values above) to run without Cloudflare or a sheet.
# The server refuses AUTH_MODE=dev and CATALOGUE_SOURCE=fixture whenever APP_ENV=production.
#APP_ENV=development
#AUTH_MODE=dev
#DEV_USER_EMAIL=dev@example.test
#CATALOGUE_SOURCE=fixture
#BOOK_LOOKUP=fixture   # canned ISBN answers, no network
#COVER_SCAN=fixture    # canned cover reader, no API key
